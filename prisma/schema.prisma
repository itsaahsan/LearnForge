datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  level        String         @default("Beginner")
  projects     Project[]
  journal      JournalEntry[]
  achievements Achievement[]
  createdAt    DateTime       @default(now())
}

model Project {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  title      String
  idea       String
  level      String
  goal       String
  milestones Milestone[]
  createdAt  DateTime    @default(now())
}

model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  objective String
  status    String  @default("locked")
  tasks     Task[]
}

model Task {
  id            String    @id @default(cuid())
  milestoneId   String
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title         String
  description   String
  status        String    @default("TODO")
  skills        String    @default("")
  estimatedTime String    @default("2h")
}

model Skill {
  id   String @id @default(cuid())
  name String @unique
}

model LearningModule {
  id    String @id @default(cuid())
  topic String
  level String
  body  String
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?
  body      String
  createdAt DateTime @default(now())
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())
}

model ProgressEvent {
  id        String   @id @default(cuid())
  projectId String
  title     String
  detail    String
  createdAt DateTime @default(now())
}

model AIConversation {
  id        String   @id @default(cuid())
  projectId String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model ProjectInsight {
  id        String   @id @default(cuid())
  projectId String
  insight   String
  createdAt DateTime @default(now())
}
